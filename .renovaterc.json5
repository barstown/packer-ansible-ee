{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigestsToSemver',
    ':disableRateLimiting',
    ':semanticCommits',
  ],
  labels: [
    'renovate',
  ],
  dependencyDashboard: {
    labels: [
      'renovate',
    ],
  },
  customManagers: [
    {
      description: 'Track the EE base image tag and digest',
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)execution-environment\\.ya?ml$/',
      ],
      matchStrings: [
        'name:\\s*["\']?(?<depName>[^\\s:@"\']+):(?<currentValue>[^\\s@"\']+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      description: 'Follow Rocky Linux minimal point releases',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'quay.io/rockylinux/rockylinux',
      ],
      allowedVersions: '/^\\d+\\.\\d+-minimal$/',
    },
    {
      description: 'rhel8-compat: Hold ansible-core to 2.16.x',
      matchPackageNames: [
        'ansible-core',
      ],
      allowedVersions: '<2.17',
    },
    {
      description: 'rhel8-compat: Hold python to <3.13',
      matchPackageNames: [
        'python',
      ],
      allowedVersions: '<3.13',
    },
    {
      description: 'rhel8-compat: Hold python to <3.13 in mise',
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        'python',
      ],
      allowedVersions: '<3.13',
    },
    {
      description: 'rhel8-compat: Hold community.general to 11.x',
      matchManagers: [
        'ansible-galaxy',
      ],
      matchPackageNames: [
        'community.general',
      ],
      allowedVersions: '<12.0.0',
    },
    {
      description: 'Major updates are breaking: feat!',
      matchUpdateTypes: [
        'major',
      ],
      semanticCommitType: 'feat',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}})!:',
      commitMessageExtra: '({{currentVersion}} ➔ {{newVersion}})',
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      semanticCommitType: 'feat',
      commitMessageExtra: '({{currentVersion}} ➔ {{newVersion}})',
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      semanticCommitType: 'fix',
      commitMessageExtra: '({{currentVersion}} ➔ {{newVersion}})',
    },
    {
      matchUpdateTypes: [
        'digest',
      ],
      semanticCommitType: 'fix',
      commitMessageExtra: '({{currentDigestShort}} ➔ {{newDigestShort}})',
    },
    {
      matchDatasources: [
        'docker',
      ],
      semanticCommitScope: 'container',
      commitMessageTopic: 'image {{depName}}',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'github-action',
      commitMessageTopic: 'action {{depName}}',
    },
    {
      matchManagers: [
        'renovate-config',
      ],
      semanticCommitType: 'chore',
      semanticCommitScope: 'renovate-config',
      commitMessageTopic: 'config {{depName}}',
    },
    {
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        '!aqua:hashicorp/packer',
      ],
      semanticCommitType: 'chore',
      semanticCommitScope: 'mise',
      commitMessageTopic: 'tool {{depName}}',
    },
    {
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        'aqua:hashicorp/packer',
      ],
      semanticCommitScope: 'packer',
      commitMessageTopic: 'Packer',
    },
    {
      description: 'zer0ver: give 0.x minors the breaking ! prefix',
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '/^v?0\\./',
      semanticCommitType: 'feat',
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}})!:',
      commitMessageExtra: '({{currentVersion}} ➔ {{newVersion}})',
    },
    {
      description: 'zer0ver: route 0.x minors onto major- branches',
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '/^v?0\\./',
      additionalBranchPrefix: 'major-',
    },
    {
      description: 'Tooling outside the image: no breaking ! prefix',
      matchManagers: [
        'github-actions',
        'renovate-config',
        'mise',
      ],
      matchDepNames: [
        '!aqua:hashicorp/packer',
      ],
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
    },
    {
      description: 'ansible-lint is CI tooling: no breaking ! prefix',
      matchManagers: [
        'pep621',
      ],
      matchPackageNames: [
        'ansible-lint',
      ],
      commitMessagePrefix: '{{semanticCommitType}}({{semanticCommitScope}}):',
    },
  ],
}
